{
  "name": "pr0postbot",
  "version": "2.0.0",
  "description": "A bot that scrapes pr0gramm.com and sends the newest post to groups",
  "main": "dist/index.js",
  "author": "enyineer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "update": "git pull && pnpm run stop && pnpm i && pnpm run build && pnpm run start",
    "test": "jest",
    "build": "prisma generate && rimraf dist && tsc",
    "lint": "eslint",
    "dev": "docker compose up -d && nodemon"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grammyjs/menu": "^1.5.0",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "luxon": "3.5.0",
    "pm2": "^5.4.3",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f"
